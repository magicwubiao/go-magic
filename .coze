[project]
sub_id = "80d87f0a"
name = "go-magic"
requires = ["golang-1.25"]
project_type = "web"
entrypoint = "cmd/magic/main.go"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "web/scripts/coze-preview-build.sh"]
run = ["bash", "web/scripts/coze-preview-run.sh"]

[deploy]
build = ["bash", "build.sh", "cli"]
run = ["bash", "scripts/run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["web"]
