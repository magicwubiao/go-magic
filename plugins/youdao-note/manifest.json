{
  "id": "youdao-note",
  "name": "Youdao Note CLI",
  "version": "1.0.0",
  "description": "Access Youdao Note (有道云笔记) via CLI",
  "long_desc": "Wraps the Youdao Note CLI to create, read, search, and manage notes. The agent can use these commands directly in conversation.",
  "author": "go-magic",
  "license": "MIT",
  "api_version": "1.0",
  "type": "script",
  "entrypoint": "youdao.sh",
  "entrypoints": {
    "windows": "youdao.ps1"
  },
  "category": "productivity",
  "tags": ["note", "youdao", "cloud", "productivity"],
  "permissions": ["network", "filesystem"],
  "config_schema": [
    {
      "key": "token",
      "type": "string",
      "description": "Youdao Note API token",
      "required": true,
      "sensitive": true,
      "env_var": "YOUDAO_TOKEN"
    },
    {
      "key": "default_notebook",
      "type": "string",
      "default": "default",
      "description": "Default notebook name"
    }
  ],
  "commands": [
    {
      "name": "list",
      "description": "List all notebooks and recent notes"
    },
    {
      "name": "search",
      "description": "Search notes by keyword",
      "arguments": ["keyword"]
    },
    {
      "name": "read",
      "description": "Read a note by ID or title",
      "arguments": ["note_id"]
    },
    {
      "name": "create",
      "description": "Create a new note",
      "arguments": ["title", "content"]
    },
    {
      "name": "delete",
      "description": "Delete a note by ID",
      "arguments": ["note_id"]
    }
  ],
  "hooks": ["on_load"],
  "events": ["youdao.note_created", "youdao.note_read"]
}
