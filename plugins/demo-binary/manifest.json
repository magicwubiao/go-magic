{
  "id": "demo-binary",
  "name": "Demo Binary Plugin",
  "version": "1.0.0",
  "description": "A binary plugin demo - cross-platform executable",
  "author": "go-magic",
  "license": "MIT",
  "api_version": "1.0",
  "type": "binary",
  "entrypoint": "demo-binary",
  "entrypoints": {
    "windows": "demo-binary.exe",
    "darwin/arm64": "demo-binary-arm64",
    "linux": "demo-binary-linux"
  },
  "category": "utilities",
  "tags": ["demo", "binary", "example"],
  "permissions": ["filesystem", "network"],
  "commands": [
    {
      "name": "hello",
      "description": "Say hello"
    },
    {
      "name": "info",
      "description": "Show system info"
    },
    {
      "name": "ping",
      "description": "Ping a host",
      "arguments": ["host"]
    }
  ],
  "hooks": ["on_load"],
  "events": ["demo-binary.loaded"]
}
