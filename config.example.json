{
  "profile": "default",
  "magic_home": "~/.magic",
  "provider": "openai",
  "model": "gpt-4o",
  "providers": {
    "openai": {
      "api_key": "your-openai-api-key-here",
      "base_url": "https://api.openai.com/v1",
      "models": ["gpt-4o", "gpt-4o-mini", "gpt-4-turbo"]
    },
    "anthropic": {
      "api_key": "your-anthropic-api-key-here",
      "models": ["claude-sonnet-4-20250514", "claude-opus-4-20250514", "claude-3-5-sonnet-20241022"]
    },
    "openrouter": {
      "api_key": "your-openrouter-api-key-here",
      "models": ["openai/gpt-4o", "anthropic/claude-3.5-sonnet"]
    },
    "deepseek": {
      "api_key": "your-deepseek-api-key-here",
      "models": ["deepseek-chat", "deepseek-reasoner"]
    },
    "doubao": {
      "api_key": "your-doubao-api-key-here",
      "models": ["doubao-pro-32k"]
    },
    "qwen": {
      "api_key": "your-qwen-api-key-here",
      "models": ["qwen-plus", "qwen-turbo", "qwen-max"]
    },
    "minimax": {
      "api_key": "your-minimax-api-key-here",
      "models": ["minimax-chat"]
    },
    "kimi": {
      "api_key": "your-kimi-api-key-here",
      "models": ["moonshot-v1-8k", "moonshot-v1-32k", "moonshot-v1-128k"]
    },
    "zhipu": {
      "api_key": "your-zhipu-api-key-here",
      "models": ["glm-4", "glm-4-plus", "glm-4-flash"]
    },
    "dashscope": {
      "api_key": "your-dashscope-api-key-here",
      "models": ["qwen-plus", "qwen-turbo", "qwen-max"]
    },
    "gemini": {
      "api_key": "your-google-api-key-here",
      "models": ["gemini-2.0-flash-exp", "gemini-1.5-flash", "gemini-1.5-pro"]
    },
    "ollama": {
      "api_key": "not-required",
      "base_url": "http://localhost:11434",
      "models": ["llama3.2", "qwen2.5", "codellama"]
    }
  },
  "bot_mode": {
    "enabled": false
  },
  "privacy": {
    "enabled": true,
    "redact_phone": true,
    "redact_email": true,
    "redact_id_card": true,
    "redact_bank_card": true,
    "redact_ip": true,
    "redact_address": true,
    "custom_patterns": {}
  }
}
